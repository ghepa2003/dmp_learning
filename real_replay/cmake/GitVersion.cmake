# Run at BUILD time (cmake -P), not at configure time: writes ${OUT} with the git state of ${SRC} that the binaries
# are compiled from. The file is rewritten only when its content changes, so an unchanged tree recompiles nothing.
#   -DSRC=<source dir inside the repository>  -DOUT=<generated header>
# safe.directory is passed per command (-c), so the repository config and the global git config are never modified
# (inside the container the bind-mounted repository belongs to another user).
set(head "unknown")
set(dirty "unknown")
set(diff_sha "none")
find_program(GIT_EXE git)
if(GIT_EXE)
  execute_process(COMMAND "${GIT_EXE}" -c safe.directory=* -C "${SRC}" rev-parse HEAD
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0)
    set(head "${out}")
    # dirty = tracked files modified (staged or not); untracked files are not counted (the configs are hashed in the meta)
    execute_process(COMMAND "${GIT_EXE}" -c safe.directory=* -C "${SRC}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE st RESULT_VARIABLE rc2 ERROR_QUIET)
    if(rc2 EQUAL 0)
      if(st STREQUAL "")
        set(dirty "0")
      else()
        set(dirty "1")
        execute_process(COMMAND "${GIT_EXE}" -c safe.directory=* -C "${SRC}" diff HEAD
                        OUTPUT_VARIABLE diff RESULT_VARIABLE rc3 ERROR_QUIET)
        if(rc3 EQUAL 0)
          string(SHA256 diff_sha "${diff}")
        endif()
      endif()
    endif()
  endif()
endif()
set(content "// generated by cmake/GitVersion.cmake at build time: do not edit\n#pragma once\n#define RR_GIT_HEAD \"${head}\"\n#define RR_GIT_DIRTY \"${dirty}\"\n#define RR_GIT_DIFF_SHA256 \"${diff_sha}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
