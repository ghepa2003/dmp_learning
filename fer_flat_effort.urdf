    <actuator name="fer_joint8_motor_tip">
      <hardwareInterface>franka_hw/FrankaModelInterface</hardwareInterface>
    </actuator>
  </transmission>
  <gazebo reference="fer_finger_joint1">
    <!-- Needed for ODE to output external wrenches on joints -->
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <transmission name="fer_finger_joint1_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="fer_finger_joint1">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="fer_finger_joint1_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </actuator>
  </transmission>
  <gazebo reference="fer_finger_joint2">
    <!-- Needed for ODE to output external wrenches on joints -->
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <transmission name="fer_finger_joint2_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="fer_finger_joint2">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="fer_finger_joint2_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </actuator>
  </transmission>
  <gazebo reference="fer_leftfinger">
    <collision>
      <max_contacts>10</max_contacts>
      <surface>
        <contact>
          <ode>
            <!-- These two parameter need application specific tuning. -->
            <!-- Usually you want no "snap out" velocity and a generous -->
            <!-- penetration depth to keep the grasping stable -->
            <max_vel>0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction>
          <ode>
            <mu>1.13</mu>
            <mu2>1.13</mu2>
          </ode>
        </friction>
        <bounce/>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="fer_rightfinger">
    <collision>
      <max_contacts>10</max_contacts>
      <surface>
        <contact>
          <ode>
            <!-- These two parameter need application specific tuning. -->
            <!-- Usually you want no "snap out" velocity and a generous -->
            <!-- penetration depth to keep the grasping stable -->
            <max_vel>0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction>
