    </joint>
    <actuator name="fer_motor1">
      <hardwareInterface>franka_hw/FrankaStateInterface</hardwareInterface>
    </actuator>
    <actuator name="fer_motor2">
      <hardwareInterface>franka_hw/FrankaStateInterface</hardwareInterface>
    </actuator>
    <actuator name="fer_motor3">
