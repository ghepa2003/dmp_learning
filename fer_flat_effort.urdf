    </actuator>
    <actuator name="fer_motor7">
      <hardwareInterface>franka_hw/FrankaStateInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="fer_franka_model">
    <type>franka_hw/FrankaModelInterface</type>
    <joint name="fer_joint1">
      <role>root</role>
      <hardwareInterface>franka_hw/FrankaModelInterface</hardwareInterface>
    </joint>
    <joint name="fer_joint8">
      <role>tip</role>
      <hardwareInterface>franka_hw/FrankaModelInterface</hardwareInterface>
    </joint>
    <actuator name="fer_joint1_motor_root">
      <hardwareInterface>franka_hw/FrankaModelInterface</hardwareInterface>
