<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>satellite_grasp_msgs</name>
  <version>0.1.0</version>
  <description>
    Interfaces-only package: GraspCommand, the one-shot output of
    satellite_grasp_planner's grasp_planner_node. No dependency on any other
    package in this workspace - only std_msgs/geometry_msgs/builtin_interfaces.
  </description>
  <maintainer email="lorenzo.ghessi@mail.polimi.it">Lorenzo Ghessi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
