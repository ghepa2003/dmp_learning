<?xml version="1.0"?>
<package format="3">
  <name>velocity_cartesian_control</name>
  <version>0.1.0</version>
  <description>Cartesian velocity controller for Franka (DLS resolved-rate), staged step before force/impedance control.</description>
  <maintainer email="you@example.com">Lorenzo</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>geometry_msgs</depend>
  <depend>Eigen3</depend>
  <depend>pinocchio</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/cartesian_velocity_controller_plugin.xml"/>
  </export>
</package>