<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="franka_arm_ros2_control" 
         params="arm_id 
             robot_ip 
             use_fake_hardware:=^|false 
             fake_sensor_commands:=^|false 
             gazebo:=^|false 
             hand:=^|false 
             gazebo_effort:=^|false">
    <ros2_control name="FrankaHardwareInterface" type="system">
        <hardware>
          <param name="arm_id">${arm_id}</param>
          <xacro:if value="${use_fake_hardware}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>

          <xacro:if value="${gazebo}">
            <plugin>franka_ign_ros2_control/IgnitionSystem</plugin>
          </xacro:if>

          <xacro:if value="${use_fake_hardware == 0 and gazebo == 0}">
            <plugin>franka_hardware/FrankaHardwareInterface</plugin>
            <param name="robot_ip">${robot_ip}</param>
          </xacro:if>
        </hardware>


      <xacro:macro name="configure_joint" params="joint_name initial_position effort_ok:=true">
          <joint name="${joint_name}">
          <xacro:if value="${effort_ok and (gazebo == 0 or gazebo_effort == 1)}">
            <command_interface name="effort"/>
          </xacro:if>
          <command_interface name="velocity"/>
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>
          <state_interface name="velocity"/>
            <param name="initial_value">0.0</param>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- initial pose, selected with the FRANKA_START_POSE env var (default: ready) -->
      <xacro:property name="start_pose" value="$(optenv FRANKA_START_POSE ready)"/>
      <xacro:property name="start_poses" value="${dict(
          ready=[0.0, -pi/4, 0.0, -3*pi/4, 0.0, pi/2, pi/4],
          ready_q6pi=[0.0, -pi/4, 0.0, -3*pi/4, 0.0, pi, pi/4],
          capture=[0.896498512761, 0.791459807260, -0.053859353227, -1.258118193175, -1.334405725411, 1.215534447462, 1.297872758350])}"/>
      <!-- unknown value: the failing KeyError carries the message (xacro has no plain "error" tag) -->
      <xacro:property name="start_q" value="${start_poses.get(start_pose) or start_poses['ERROR: FRANKA_START_POSE must be one of ready, ready_q6pi, capture (got ' + start_pose + ')']}"/>

      <xacro:configure_joint joint_name="${arm_id}_joint1" initial_position="${start_q[0]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint2" initial_position="${start_q[1]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint3" initial_position="${start_q[2]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint4" initial_position="${start_q[3]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint5" initial_position="${start_q[4]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint6" initial_position="${start_q[5]}"/>
      <xacro:configure_joint joint_name="${arm_id}_joint7" initial_position="${start_q[6]}"/>
    <xacro:if value="${gazebo and hand}">
      <joint name="${arm_id}_finger_joint1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${arm_id}_finger_joint2">
        <param name="mimic">${arm_id}_finger_joint1</param>
        <param name="multiplier">1</param>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:if>

    </ros2_control>
    <xacro:if value="${gazebo}">
      <gazebo>
        <plugin filename="franka_ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>$(find franka_gazebo_bringup)/config/franka_gazebo_controllers.yaml</parameters>
        </plugin>
      </gazebo>
      <gazebo>
        <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
          <joint_name>${arm_id}_finger_joint1</joint_name>
          <topic>gripper_position_cmd</topic>
          <p_gain>300</p_gain>
          <i_gain>0</i_gain>
          <d_gain>60.0</d_gain>
          <cmd_max>100</cmd_max>
          <cmd_min>-100</cmd_min>
        </plugin>
      </gazebo>
      <!-- second finger: the URDF mimic does not reach the SDF, so finger 2 needs its own controller -->
      <gazebo>
        <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
          <joint_name>${arm_id}_finger_joint2</joint_name>
          <topic>gripper_position_cmd</topic>
          <p_gain>300</p_gain>
          <i_gain>0</i_gain>
          <d_gain>60.0</d_gain>
          <cmd_max>100</cmd_max>
          <cmd_min>-100</cmd_min>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>