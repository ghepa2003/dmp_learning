<?xml version="1.0"?>
<!--
  free_target_object.sdf.xacro

  A SINGLE rigid link, completely free in the Gazebo (Ignition Fortress) world:
    * no <joint> to the world, no fixed/prismatic/revolute chain
    * no <ros2_control>, no motion/force plugin
    * <gravity>0</gravity> on the link (space scenario, same approach as
      testing_plane's physical box link)

  It therefore obeys only its own rigid-body dynamics: F = m*a and
  I*omega_dot = tau. With the default arguments (zero initial twist) nothing
  drives it after spawn -> ideal "body at rest" target for VIM validation.

  Pose + twist readout on ROS 2: the model carries an OdometryPublisher plugin
  (observation only, applies no force) that publishes ignition.msgs.Odometry on
  /model/<name>/odometry; the launch file bridges it to nav_msgs/msg/Odometry
  on /<name>/odometry. This gives a properly sim-time-stamped world pose (frame
  world -> <name>) AND the body's linear/angular twist.
  (Earlier attempts were dropped: a model PosePublisher - publish_model_pose is
  a no-op in gz-sim6 6.18.0, publish_link_pose is only model-relative; then a
  dynamic_pose/info -> TFMessage bridge - the SceneBroadcaster Pose_V has no
  per-entity header, so every bridged transform had a zero stamp / empty
  frame_id.)

  Parametrisable via xacro args (all overridable at expand time):
    name              model name in Gazebo                 (default free_target_object)
    mass              link mass [kg]                        (default 4.412, real satellite; the
                      SINGLE place where the mass lives: the launch forwards it only if given)
    size_x/y/z        cube edge lengths [m]                 (default 0.150 each)
    ixx/iyy/izz       inertia about the origin = CoM [kg m^2], MODEL frame (CAD tensor permuted,
    ixy/ixz/iyz       see below). Defaults are the real satellite's. ixx/iyy/izz = 0 => use the
                      solid-homogeneous-box formula (and the products are then still ixy/ixz/iyz).
    satellite_color   "r g b a" of the mesh visual (ambient = diffuse) (default 0.85 0.45 0.10 1)
    show_rotation_marker  red 0.10 x 0.02 x 0.01 m bar on the +z face, visual only (default false)
    mesh_uri          visual mesh (satellite_m.stl, CAD frame); empty => box visual + collar boxes
                      as visual proxy. The launch always passes the absolute file:// URI.
    use_velocity_control  emit the VelocityControl plugin   (default false)
    initial_linear    "vx vy vz" [m/s]   (only if use_velocity_control=true)
    initial_angular   "wx wy wz" [rad/s] (only if use_velocity_control=true)

  NOTE on the rotating case: VelocityControl (shipped with Fortress, no extra
  setup) is the only velocity mechanism that loads on an already-running
  server. It CONTINUOUSLY re-asserts the commanded twist on the canonical
  link, so it holds omega constant. The real inertia is anisotropic (and
  slightly off-diagonal), so this suppresses nutation (I*omega_dot = tau is
  not integrated); the spin about the model z axis (a near-principal axis)
  is held exactly. Leave use_velocity_control=false for a genuinely free body.
-->
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.9">

  <xacro:arg name="name" default="free_target_object"/>
  <!-- REAL SATELLITE (CAD). Mass: single point, edit here (or pass mass:= to the launch).
       Inertia about the origin (= CoM), CAD frame [kg m^2]: Ixx 0.0189576, Iyy 0.0190063,
       Izz 0.0167266, Ixy 2.345e-9, Ixz 3.0e-7, Iyz 2.296e-8. CAD -> model axes (proper
       rotation, cyclic permutation): x_model = z_CAD (collar axis), y_model = x_CAD,
       z_model = y_CAD (spin axis). I_model = R I_CAD R^T, R = [[0 0 1],[1 0 0],[0 1 0]], i.e.
         ixx = Izz_CAD, iyy = Ixx_CAD, izz = Iyy_CAD,
         ixy = Ixz_CAD, ixz = Iyz_CAD, iyz = Ixy_CAD.
       Products are entered as the matrix entries (SDF convention). Nominal values: dynamics is
       not the objective here. -->
  <xacro:arg name="mass" default="4.412"/>
  <xacro:arg name="size_x" default="0.150"/>
  <xacro:arg name="size_y" default="0.150"/>
  <xacro:arg name="size_z" default="0.150"/>
  <xacro:arg name="ixx" default="0.0167266"/>
  <xacro:arg name="iyy" default="0.0189576"/>
  <xacro:arg name="izz" default="0.0190063"/>
  <xacro:arg name="ixy" default="3.0e-7"/>
  <xacro:arg name="ixz" default="2.296e-8"/>
  <xacro:arg name="iyz" default="2.345e-9"/>
  <xacro:arg name="mesh_uri" default=""/>
  <xacro:arg name="satellite_color" default="0.85 0.45 0.10 1"/>
  <xacro:arg name="show_rotation_marker" default="false"/>
  <xacro:arg name="use_velocity_control" default="false"/>
  <xacro:arg name="initial_linear" default="0 0 0"/>
  <xacro:arg name="initial_angular" default="0 0 0"/>
  <!--
  COLLAR PROXY (optional; xacro args below). Kept in a top-level comment because xacro copies the
  header comment into every expanded SDF and with_collar=false must stay byte-identical.

    with_collar       add the hollow-collar proxy to link `body`     (default false -> output
                      IDENTICAL to a model without this feature)
    collar_collision  give the collar <collision> elements; read     (default true)
                      only if with_collar=true (false = visual only)
    collar_segments   N boxes approximating the hollow cylinder      (default 24)
    collar_radius_m   OUTER radius [m]                               (default 0.0725)
    wall_thickness_m  radial wall [m]; inner radius = R - wall       (default 0.009)
    standoff_m        collar length along +x from the cube face [m]  (default 0.08)
    The last three names and defaults are those of the grasp planner's
    CubeSatelliteModel::Params (collar_radius_m, wall_thickness_m, standoff_m); the cube side is
    size_x. tools/check_collar_defaults.py fails if they diverge.

  Collar (with_collar=true): a hollow cylinder on the +x face of the cube, axis = link +x, from
  x = size_x/2 to size_x/2 + standoff_m. The axis must coincide with face_normal_body = [1,0,0]
  of the planner's example YAML and with the CubeSatelliteModel::Params default. The dimensions
  are those of the real satellite CAD (outer R 72.5 mm, inner 63.5 mm, wall 9 mm, 80 mm from the
  face to the rim). The ring of boxes is the COLLISION model only; when mesh_uri is set the
  visual is the CAD mesh (cube + collar), taken from the CAD frame through the fixed pose
  `0 0 0 pi/2 0 pi/2` (pure axis permutation, no translation; origin = cube centre = CoM). It is
  built inside link `body` (no new link/joint): odometry, twist and <inertial> are those of the
  whole satellite (the <inertial> already includes the collar). Geometry: N rectangular boxes (x-length standoff, radial thickness wall, tangential
  width 2 R tan(pi/N) * (1 + overlap)), radial flats at R and R - wall, centred on the
  mid-radius; adjacent boxes overlap by `overlap` (5 %) so there are no gaps. The bore stays
  free: its flats sit at radius r = R - wall (polygon circumscribing the inner circle, so the
  clearance is >= r everywhere, at most r/cos(pi/N) at the vertices), the outer box corners
  reach hypot(R, w/2) (N=24: 0.47 mm beyond R; the bore is up to 0.30 mm wider than r).
  -->
  <xacro:arg name="with_collar" default="false"/>
  <xacro:arg name="collar_collision" default="true"/>
  <xacro:arg name="collar_segments" default="24"/>
  <xacro:arg name="collar_radius_m" default="0.0725"/>
  <xacro:arg name="wall_thickness_m" default="0.009"/>
  <xacro:arg name="standoff_m" default="0.08"/>

  <!-- Bind args as numbers -->
  <xacro:property name="m"  value="${float('$(arg mass)')}"/>
  <xacro:property name="sx" value="${float('$(arg size_x)')}"/>
  <xacro:property name="sy" value="${float('$(arg size_y)')}"/>
  <xacro:property name="sz" value="${float('$(arg size_z)')}"/>
  <xacro:property name="ixx_arg" value="${float('$(arg ixx)')}"/>
  <xacro:property name="iyy_arg" value="${float('$(arg iyy)')}"/>
  <xacro:property name="izz_arg" value="${float('$(arg izz)')}"/>
  <xacro:property name="ixy_arg" value="${float('$(arg ixy)')}"/>
  <xacro:property name="ixz_arg" value="${float('$(arg ixz)')}"/>
  <xacro:property name="iyz_arg" value="${float('$(arg iyz)')}"/>
  <xacro:property name="use_mesh" value="${'$(arg mesh_uri)' != ''}"/>

  <!-- Solid homogeneous box inertia about the centre of mass -->
  <xacro:property name="box_ixx" value="${m * (sy*sy + sz*sz) / 12.0}"/>
  <xacro:property name="box_iyy" value="${m * (sx*sx + sz*sz) / 12.0}"/>
  <xacro:property name="box_izz" value="${m * (sx*sx + sy*sy) / 12.0}"/>

  <!-- An explicit i** arg > 0 overrides the formula -->
  <xacro:property name="final_ixx" value="${ixx_arg if ixx_arg > 0.0 else box_ixx}"/>
  <xacro:property name="final_iyy" value="${iyy_arg if iyy_arg > 0.0 else box_iyy}"/>
  <xacro:property name="final_izz" value="${izz_arg if izz_arg > 0.0 else box_izz}"/>

  <!-- Collar proxy (only used when with_collar=true; see header). Every value below is inert
       when the collar is off. Validation raises (generator throw) so a bad value fails loudly; xacro properties are lazy,
       so collar_check is referenced from the with_collar guard below. -->
  <xacro:property name="with_collar" value="${'$(arg with_collar)'.lower() == 'true'}"/>
  <xacro:property name="collar_collision" value="${'$(arg collar_collision)'.lower() == 'true'}"/>
  <xacro:property name="collar_n" value="${int('$(arg collar_segments)')}"/>
  <xacro:property name="collar_R" value="${float('$(arg collar_radius_m)')}"/>
  <xacro:property name="collar_wall" value="${float('$(arg wall_thickness_m)')}"/>
  <xacro:property name="collar_len" value="${float('$(arg standoff_m)')}"/>
  <xacro:property name="collar_overlap" value="0.05"/>
  <xacro:property name="collar_valid" value="${(not with_collar) or (collar_n >= 8 and 0.0 &lt; collar_wall &lt; collar_R and collar_len > 0.0 and collar_R &lt;= 0.5 * min(sy, sz))}"/>
  <xacro:property name="collar_check" value="${True if collar_valid else (_ for _ in ()).throw(ValueError('free_target_object: invalid collar arguments: need collar_segments at least 8, wall_thickness_m in (0, collar_radius_m), collar_radius_m at most min(size_y, size_z)/2, standoff_m positive'))}"/>
  <xacro:property name="collar_rm" value="${0.5 * (collar_R + (collar_R - collar_wall))}"/>
  <xacro:property name="collar_w" value="${2.0 * collar_R * tan(pi / collar_n) * (1.0 + collar_overlap)}"/>
  <xacro:property name="collar_xc" value="${0.5 * sx + 0.5 * collar_len}"/>

  <!-- One collar segment, recursive (xacro has no loop): segment i at angle phi = 2 pi i / N
       about +x. Local box axes: x = along the collar, y = radial, z = tangential. -->
  <xacro:macro name="collar_segment" params="i">
    <xacro:if value="${i &lt; collar_n}">
      <xacro:property name="phi" value="${2.0 * pi * i / collar_n}"/>
      <xacro:property name="seg_pose" value="${'%.9f %.9f %.9f %.9f 0 0' % (collar_xc, collar_rm * cos(phi), collar_rm * sin(phi), phi)}"/>
      <xacro:if value="${collar_collision}">
        <collision name="collar_seg_${i}">
          <pose>${seg_pose}</pose>
          <geometry>
            <box>
              <size>${collar_len} ${collar_wall} ${collar_w}</size>
            </box>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual name="collar_seg_${i}_visual">
          <pose>${seg_pose}</pose>
          <geometry>
            <box>
              <size>${collar_len} ${collar_wall} ${collar_w}</size>
            </box>
          </geometry>
          <material>
            <ambient>0.90 0.55 0.10 0.5</ambient>
            <diffuse>0.90 0.55 0.10 0.5</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </xacro:unless>
      <xacro:collar_segment i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>

  <model name="$(arg name)">
    <!-- Spawn pose is supplied by the spawner (`ros_gz_sim create -x -y -z ...`);
         keep the model's own pose at the origin. -->
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="body">
      <!-- Space scenario: no weight force on the body. -->
      <gravity>0</gravity>

      <inertial>
        <mass>${m}</mass>
        <inertia>
          <ixx>${final_ixx}</ixx>
          <ixy>${ixy_arg}</ixy>
          <ixz>${ixz_arg}</ixz>
          <iyy>${final_iyy}</iyy>
          <iyz>${iyz_arg}</iyz>
          <izz>${final_izz}</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>${sx} ${sy} ${sz}</size>
          </box>
        </geometry>
      </collision>

      <xacro:if value="${use_mesh}">
        <!-- CAD mesh (metres, CAD frame) -> model frame: fixed axis permutation, no translation. -->
        <visual name="visual">
          <pose>0 0 0 ${pi / 2.0} 0 ${pi / 2.0}</pose>
          <geometry>
            <mesh>
              <uri>$(arg mesh_uri)</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>$(arg satellite_color)</ambient>
            <diffuse>$(arg satellite_color)</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_mesh}">
        <visual name="visual">
          <geometry>
            <box>
              <size>${sx} ${sy} ${sz}</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.45 0.90 1</ambient>
            <diffuse>0.10 0.45 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </xacro:unless>

      <!-- Optional rotation marker: thin red bar flat on the +z face (spin axis), near the +y edge.
           Visual only: no collision, no inertial contribution. -->
      <xacro:if value="${'$(arg show_rotation_marker)'.lower() == 'true'}">
        <visual name="rotation_marker">
          <pose>0 ${0.5 * sy - 0.02} ${0.5 * sz + 0.005} 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.02 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.90 0.05 0.05 1</ambient>
            <diffuse>0.90 0.05 0.05 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </xacro:if>

      <xacro:if value="${with_collar and collar_check}">
        <xacro:collar_segment i="0"/>
      </xacro:if>
    </link>

    <!-- Pose + twist readout for ROS 2. OdometryPublisher ships with Fortress
         (default plugin dir) and publishes ignition.msgs.Odometry on
         /model/$(arg name)/odometry with a real sim-time stamp and proper
         frame ids (odom_frame -> robot_base_frame). Observation only: it
         reports the model's world pose and its linear + angular twist, and
         applies no force. <dimensions>3</dimensions> is mandatory here - the
         default is 2 (planar), wrong for a free 3D body. Publish rate matches
         this project's other pose streams (/target_pose is 200 Hz). -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>$(arg name)</robot_base_frame>
      <odom_publish_frequency>200</odom_publish_frequency>
    </plugin>

    <!-- Optional: seed an initial twist. Emitted only when explicitly asked
         for; with use_velocity_control=false the model carries only the
         observation-only OdometryPublisher above. -->
    <xacro:if value="${'$(arg use_velocity_control)'.lower() == 'true'}">
      <plugin filename="ignition-gazebo-velocity-control-system"
              name="ignition::gazebo::systems::VelocityControl">
        <initial_linear>$(arg initial_linear)</initial_linear>
        <initial_angular>$(arg initial_angular)</initial_angular>
      </plugin>
    </xacro:if>

  </model>
</sdf>
