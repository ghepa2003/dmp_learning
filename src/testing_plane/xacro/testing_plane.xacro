<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="testing_plane">
    <xacro:property name="robot_namespace" value="testing_plane"/>

	<xacro:property name="h_testing_plane" value="0.1" />
	<xacro:property name="l_testing_plane" value="0.1" />
	<xacro:property name="w_testing_plane" value="0.1" />

    <xacro:property name="absolute_height" value="1.0" />

    <xacro:property name="initial_x" value="0.5" />
    <xacro:property name="initial_y" value="0.0" />
    <xacro:property name="initial_z" value="0.05" />

    <link name="${robot_namespace}_dummy_fixed_link">
         <inertial>
            <mass value="1e6" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia
                ixx="1e6" ixy="0.0" ixz="0.0"
                iyy="1e6" iyz="0.0"
                izz="1e6"/>
+        </inertial>
+    </link>

    <joint name="${robot_namespace}_fixed_joint" type="fixed">
        <parent link="${robot_namespace}_dummy_fixed_link"/>
        <child link="${robot_namespace}_dummy_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${robot_namespace}_dummy_link">
        <inertial>
            <mass value="1e6"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e6" ixy="0.0" ixz="0.0"
                    iyy="1e6" iyz="0.0"
                    izz="1e6"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
    </link>

    <joint name="${robot_namespace}_trasl_x_joint" type="prismatic">
        <parent link="${robot_namespace}_dummy_link"/>
        <child link="${robot_namespace}_trasl_x_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_trasl_x_link">
        <!-- <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
        </visual> -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>
		
    <joint name="${robot_namespace}_trasl_y_joint" type="prismatic">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_trasl_x_link" />
        <child link="${robot_namespace}_trasl_y_link" />
        <axis xyz="0 1 0"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_trasl_y_link">
        <!-- <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
        </visual> -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>

    <joint name="${robot_namespace}_trasl_z_joint" type="prismatic">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_trasl_y_link" />
        <child link="${robot_namespace}_trasl_z_link" />
        <axis xyz="0 0 1"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_trasl_z_link">
        <!-- <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
        </visual> -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>

    <joint name="${robot_namespace}_rot_x_joint" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_trasl_z_link" />
        <child link="${robot_namespace}_rot_x_link" />
        <axis xyz="1 0 0"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_rot_x_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>

    <joint name="${robot_namespace}_rot_y_joint" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_rot_x_link" />
        <child link="${robot_namespace}_rot_y_link" />
        <axis xyz="0 1 0"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_rot_y_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>

    <joint name="${robot_namespace}_rot_z_joint" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_rot_y_link" />
        <child link="${robot_namespace}_rot_z_link" />
        <axis xyz="0 0 1"/>
        <limit effort="1e6" lower="-999999" upper="999999" velocity="999999"/>
        <dynamics damping="100" friction="100" />
    </joint>

    <link name="${robot_namespace}_rot_z_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1e-6 1e-6 1e-6" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0"
                    iyy="1e-3" iyz="0.0"
                    izz="1e-3"/>
        </inertial>
    </link>

    <joint name="${robot_namespace}_testing_plane_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${robot_namespace}_rot_z_link" />
        <child link="${robot_namespace}_link" />
    </joint>

    <link name="${robot_namespace}_link">

        <inertial>
            <mass value="1.0" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia
                ixx="1e-1" ixy="0.0" ixz="0.0"
                iyy="1e-1" iyz="0.0"
                izz="1e-1"/>
        </inertial>

        <collision name="collision">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${h_testing_plane} ${l_testing_plane} ${w_testing_plane}"/>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                    <torsional>
                        <ode/>
                    </torsional>
                </friction>
                <contact>
                    <ode/>
                </contact>
                <bounce/>
            </surface>
            <max_contacts>10</max_contacts>
        </collision>

        <visual name="visual">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${h_testing_plane} ${l_testing_plane} ${w_testing_plane}"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>0</gravity>
    </link>

    <gazebo reference="${robot_namespace}_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <ros2_control name="${robot_namespace}" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="${robot_namespace}_trasl_x_joint">
            <!-- <command_interface name="effort"/>
            <command_interface name="position"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">${initial_x}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${robot_namespace}_trasl_y_joint">
            <!-- <command_interface name="effort"/>
            <command_interface name="position"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">${initial_y}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${robot_namespace}_trasl_z_joint">
            <!-- <command_interface name="effort"/>
            <command_interface name="position"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">${initial_z}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${robot_namespace}_rot_x_joint">
            <!-- <command_interface name="effort"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${robot_namespace}_rot_y_joint">
            <!-- <command_interface name="effort"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${robot_namespace}_rot_z_joint">
            <!-- <command_interface name="effort"/> -->
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

	<xacro:arg name="testing_plane_controllers" default="$(find testing_plane)/config/testing_plane_controllers.yaml" />

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <ros>
                <namespace>/testing_plane</namespace>
            </ros>
            <parameters>$(arg testing_plane_controllers)</parameters>
            <controller_manager_node_name>controller_manager</controller_manager_node_name>
        </plugin>
    </gazebo>
</robot>
